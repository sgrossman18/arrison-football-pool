# Postgres (Neon, or any Postgres host). DATABASE_URL is the pooled
# connection the app uses at runtime; DIRECT_URL is the unpooled connection
# used only for running migrations (Neon gives you both — see DEPLOY.md).
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"

# Comma-separated emails that are auto-promoted to admin the first time they
# sign in. Add every family admin here (e.g. yourself + one co-admin).
ADMIN_EMAILS="samuel.w.grossman@gmail.com"

# Resend (https://resend.com) sends the magic-link sign-in emails in
# production. Leave unset locally — sign-in links are printed to the server
# console instead so you can test without an email account.
RESEND_API_KEY=""
EMAIL_FROM="Arrison Football Pool <picks@yourdomain.com>"

# ESPN's public scoreboard endpoint needs no key; see lib/espn.ts.

# Vercel Blob — stores photos admins drop into the weekly intro. Create one
# at https://vercel.com (your project) -> Storage -> Create Database -> Blob
# -> Connect to Project (free tier). Vercel usually injects this env var
# automatically once connected; if not, copy it from there.
BLOB_READ_WRITE_TOKEN=""
