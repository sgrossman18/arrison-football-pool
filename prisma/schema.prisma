generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for normal app queries (serverless-friendly).
  url       = env("DATABASE_URL")
  // Unpooled connection, used only when running migrations.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  players       Player[]
  cheatClicks   CheatClick[]
  eggSubmissions EggSubmission[]
  apiTokens     ApiToken[]
  deviceTokens  DeviceToken[]
}

// The actual pool participant/picker. Usually one Player per User, but a
// login can own several — e.g. a parent's email signs in and submits picks
// for their kids too, each as their own named Player with their own
// standings.
model Player {
  id          String   @id @default(cuid())
  name        String
  ownerUserId String
  createdAt   DateTime @default(now())

  owner         User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  picks         Pick[]
  lockOverrides LockOverride[]
}

// NextAuth (Auth.js) required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Season {
  id    String @id @default(cuid())
  year  Int    @unique
  weeks Week[]
}

model Week {
  id            String   @id @default(cuid())
  seasonId      String
  weekNumber    Int
  // Rich-ish intro shown on the picks page: plain text/markdown, can include
  // image/GIF URLs which the UI renders inline.
  introMarkdown String   @default("")
  // Whole-week lock: derived by default from the earliest game's kickoff,
  // but an admin can force an early/late lock here (e.g. for special cases).
  locksAt       DateTime?
  // Set once the weekly results/standings email goes out, so the scheduled job
  // (which may run more than once) can never send it twice.
  resultsEmailSentAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  games         Game[]
  lockOverrides LockOverride[]
  cheatClicks   CheatClick[]
  eggSubmissions EggSubmission[]

  @@unique([seasonId, weekNumber])
}

model Game {
  id           String    @id @default(cuid())
  weekId       String
  homeTeam     String // team abbreviation, e.g. "KC"
  awayTeam     String
  kickoff      DateTime
  // Display order within the week (lowest first); admins reorder with the
  // arrows or "Sort by game time" on the week editor.
  sortOrder    Int       @default(0)
  // Real start time from ESPN's schedule, filled in when an admin sorts by
  // game time. Only used for ordering/display — `kickoff` above stays a mirror
  // of the week's deadline.
  startTime    DateTime?
  // ESPN scoreboard event id, used to poll/match this game to live scores.
  espnEventId  String?
  homeScore    Int?
  awayScore    Int?
  // When picks for this game lock. Null means it locks with the week's main
  // deadline (Week.locksAt); set for games that must lock earlier, like
  // Thanksgiving, Friday and Saturday games.
  locksAt      DateTime?
  // SCHEDULED | IN_PROGRESS | FINAL
  status       String    @default("SCHEDULED")
  updatedAt    DateTime  @updatedAt

  week  Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  picks Pick[]
}

model Pick {
  id           String   @id @default(cuid())
  playerId     String
  gameId       String
  pickedTeam   String // team abbreviation
  confidence   Int // 1-5, unique per player per week
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([playerId, gameId])
}

// Admin-granted exception letting one player submit/edit picks after a week
// has otherwise locked.
model LockOverride {
  id        String   @id @default(cuid())
  weekId    String
  playerId  String
  note      String?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  week   Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([weekId, playerId])
}

// Logged every time someone clicks the "Cheat here!" nav link — a joke trap
// that rickrolls them and immediately alerts the admin. Tied to the week so
// the results email can call out that week's offenders.
model CheatClick {
  id        String   @id @default(cuid())
  weekId    String
  userId    String
  createdAt DateTime @default(now())
  // How long they stayed on the rickroll page before navigating away or
  // closing the tab, reported by a beacon fired on page unload. Null until
  // that beacon arrives (or forever, if they just leave the tab open).
  durationSeconds Int?

  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A guess at the easter egg hidden in a week's intro, submitted from the Egg
// page and shown only to admins (on that week's results page) for grading.
model EggSubmission {
  id        String   @id @default(cuid())
  weekId    String
  userId    String
  response  String
  createdAt DateTime @default(now())

  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Bearer tokens for the mobile app (/api/v1). Only the SHA-256 hash of the
// token is stored. Minted by POST /api/v1/auth/verify-code.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  deviceName String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time sign-in codes emailed to the mobile app (replaces the magic link).
// Only an HMAC of the code is stored.
model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

// An iPhone registered for push notifications (pick reminders, "results are
// in"). `environment` is which APNs host the token belongs to: Xcode/dev builds
// get sandbox tokens, TestFlight/App Store builds get production ones.
model DeviceToken {
  id          String   @id @default(cuid())
  userId      String
  apnsToken   String   @unique
  environment String // sandbox | production
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
